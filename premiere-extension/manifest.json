{
  "manifestVersion": 5,
  "id": "com.geministudio.premiere.panel",
  "name": "Mickey Studio",
  "version": "2.8.33",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "Mickey Studio"
      },
      "minimumSize": { "width": 300, "height": 450 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 450, "height": 750 },
      "resizable": true
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": ["https", "http"]
    },
    "network": {
      "domains": "all"
    }
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "assets/icons/icon-dark-24.png",
      "scale": [1],
      "theme": ["dark", "darkest", "medium"]
    },
    {
      "width": 24,
      "height": 24,
      "path": "assets/icons/icon-dark.png",
      "scale": [2],
      "theme": ["dark", "darkest", "medium"]
    },
    {
      "width": 24,
      "height": 24,
      "path": "assets/icons/icon-light-24.png",
      "scale": [1],
      "theme": ["light", "lightest"]
    },
    {
      "width": 24,
      "height": 24,
      "path": "assets/icons/icon-light.png",
      "scale": [2],
      "theme": ["light", "lightest"]
    }
  ]
}
